############
# ICC Desk — self-hosted Supabase environment template.
#
# THIS REPOSITORY IS PUBLIC. Every value here is a placeholder.
# The real file lives only at /srv/supabase/.env on the VPS, chmod 600,
# root-owned, and is written by ops/supabase/generate-secrets.sh.
#
# Every variable below is interpolated by docker-compose.yml in this
# directory. Variables that upstream needs only for the services we pruned
# (studio, meta, functions, imgproxy, analytics, vector, supavisor) are
# deliberately absent — see the note at the end of this file.
############


############
# Secrets — generated on the server, never committed
############

# Postgres superuser password. Also used by authenticator,
# supabase_auth_admin and supabase_storage_admin (see volumes/db/roles.sql).
POSTGRES_PASSWORD=REPLACE_ME

# Legacy symmetric HS256 signing key. ANON_KEY and SERVICE_ROLE_KEY are JWTs
# signed with THIS value — changing it invalidates both keys and every session.
JWT_SECRET=REPLACE_ME_40_PLUS_CHARS

# Legacy API keys: HS256-signed JWTs carrying {"iss":"supabase","role":"..."}.
# NOT random strings. A random value here yields a stack that starts and then
# 401s every request. generate-secrets.sh signs them from JWT_SECRET.
ANON_KEY=REPLACE_ME_JWT_SIGNED_WITH_JWT_SECRET
SERVICE_ROLE_KEY=REPLACE_ME_JWT_SIGNED_WITH_JWT_SECRET

# Phoenix signing salt for Realtime. Must be at least 64 characters.
SECRET_KEY_BASE=REPLACE_ME_64_CHARS

# S3-protocol credentials for the Storage API. Used by the rclone file
# migration (see docs/RUNBOOK.md and the migration script), not by the app.
# ID: openssl rand -hex 16   SECRET: openssl rand -hex 32
S3_PROTOCOL_ACCESS_KEY_ID=REPLACE_ME_32_HEX
S3_PROTOCOL_ACCESS_KEY_SECRET=REPLACE_ME_64_HEX

# Asymmetric / opaque API keys (Supabase's newer sb_ key scheme). This stack
# uses the legacy HS256 keys only; leave all four empty.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=


############
# URLs
#
# nginx terminates TLS on 443 and proxies /sb/ to kong on 127.0.0.1:8001,
# stripping the /sb prefix, so Kong sees /auth/v1/..., /rest/v1/..., etc.
#
# The vhost also answers to the older iccdesk.duckdns.org, but these must
# name the canonical host: GoTrue builds redirect targets from them.
############

SITE_URL=https://chat.icenterconsult.com
API_EXTERNAL_URL=https://chat.icenterconsult.com/sb
SUPABASE_PUBLIC_URL=https://chat.icenterconsult.com/sb
ADDITIONAL_REDIRECT_URLS=


############
# Database
#
# POSTGRES_PORT is the port INSIDE the container network only. The database
# port is not published on the host at all — reach it with
# `docker compose exec -T db psql -U supabase_admin -d postgres`.
############

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432


############
# Auth (GoTrue)
#
# Admin-provisioned accounts only: no public signup, no email delivery.
# Existing users' bcrypt password hashes migrate as-is, so nobody has to
# reset a password — which matters, because nobody can receive mail here.
############

DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
JWT_EXPIRY=3600

# No SMTP server is deployed and no mail is expected to leave this box.
# These exist because GoTrue interpolates them; they must not point at a
# real relay.
SMTP_ADMIN_EMAIL=noreply@iccdesk.duckdns.org
SMTP_HOST=localhost
SMTP_PORT=2500
SMTP_USER=unused-no-mail-delivery
SMTP_PASS=unused-no-mail-delivery
SMTP_SENDER_NAME=ICC Desk

MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"


############
# REST (PostgREST)
############

PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public


############
# Storage
#
# File-backed storage under ./volumes/storage. Image transformation is off
# because imgproxy is not deployed. GLOBAL_S3_BUCKET / REGION /
# STORAGE_TENANT_ID keep upstream's `stub` values: with STORAGE_BACKEND=file
# they only name the on-disk directory layout, and changing them orphans
# existing files.
############

STORAGE_BACKEND=file
FILE_SIZE_LIMIT=52428800
GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub


############
# Deliberately absent
#
# Upstream's .env.example also carries the variables below. Nothing in this
# pruned docker-compose.yml interpolates them, so setting them here would be
# misleading:
#
#   VAULT_ENC_KEY, POOLER_TENANT_ID, POOLER_PROXY_PORT_TRANSACTION,
#   POOLER_DEFAULT_POOL_SIZE, POOLER_MAX_CLIENT_CONN, POOLER_DB_POOL_SIZE
#       -> supavisor (the pooler) is pruned.
#   LOGFLARE_PUBLIC_ACCESS_TOKEN, LOGFLARE_PRIVATE_ACCESS_TOKEN,
#   GOOGLE_PROJECT_ID, GOOGLE_PROJECT_NUMBER, DOCKER_SOCKET_LOCATION
#       -> analytics (Logflare) and vector are never enabled.
#   PG_META_CRYPTO_KEY, STUDIO_DEFAULT_ORGANIZATION, STUDIO_DEFAULT_PROJECT,
#   OPENAI_API_KEY, DASHBOARD_USERNAME, DASHBOARD_PASSWORD
#       -> studio and meta are pruned, and with them Kong's dashboard route
#          and its basic-auth credentials.
#   FUNCTIONS_VERIFY_JWT     -> edge functions are pruned.
#   IMGPROXY_AUTO_WEBP       -> imgproxy is pruned.
#   MINIO_ROOT_USER, MINIO_ROOT_PASSWORD, PROXY_DOMAIN, CERTBOT_EMAIL,
#   KONG_HTTP_PORT, KONG_HTTPS_PORT, COMPOSE_FILE
#       -> optional upstream overlays we do not use; the kong port is
#          hardcoded to 127.0.0.1:8000 so it cannot accidentally go public.
#   REALTIME_SLOT_NAME
#       -> not a Realtime environment variable. Realtime names its own
#          replication slot per tenant; max_slot_wal_keep_size=512MB in the
#          db command is what actually bounds a lagging slot.
#
# Two upstream variables have defaults baked into docker-compose.yml and are
# omitted on purpose rather than committed with a weak value:
#   REALTIME_DB_ENC_KEY  (defaults to upstream's `supabaserealtime`; must be
#                         EXACTLY 16 characters if you set it. It encrypts the
#                         tenant row in the local _realtime schema.)
#   JWT_JWKS             (unset -> PostgREST falls back to JWT_SECRET.)
############
