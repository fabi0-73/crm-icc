# Supabase project settings — copy to .env.local and fill in
# from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server only, never exposed to the browser.
# Used exclusively for user provisioning/deactivation (Auth Admin API).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of this app (used in invite/reset email redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional WebRTC TURN (defaults work with the VPS coturn install)
# NEXT_PUBLIC_TURN_HOST=your-turn-host
# NEXT_PUBLIC_TURN_USER=your-turn-user
# NEXT_PUBLIC_TURN_PASS=your-turn-password

# LiveKit — group call media (SFU). Create a project at livekit.io, then
# Settings > Keys. URL is public (the browser connects to it); key/secret are
# server-only and mint short-lived join tokens. 1:1 calls stay peer-to-peer
# and do not use LiveKit.
# NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=your-livekit-api-key
# LIVEKIT_API_SECRET=your-livekit-api-secret

# Web Push (closed-app message/call notifications). Generate a pair with:
#   npx web-push generate-vapid-keys
# Public key is inlined into the client bundle; private key is server-only.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID_SUBJECT=mailto:support@icenterconsult.com
